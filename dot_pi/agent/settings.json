{
  "lastChangelogVersion": "1.5.0",
  "theme": "nordfox",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-6-luna",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    {
      "source": "../../github/JuanCrg90/pi-extensions/packages/nightfox-themes",
      "themes": [
        "-themes/carbonfox.json",
        "-themes/dawnfox.json",
        "-themes/dayfox.json",
        "-themes/duskfox.json",
        "-themes/nightfox.json",
        "-themes/terafox.json"
      ]
    },
    "npm:pi-autoresearch",
    "npm:@narumitw/pi-usage",
    "npm:@tintinweb/pi-tasks",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/earendil-works/pi-review"
  ],
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "enabledModels": [
    "github-copilot/*",
    "linode-inference/moonshotai/kimi*",
    "linode-inference/google/gemma*"
  ],
  "subagents": {
    "defaultModel": "gpt-6-luna",
    "modelScope": {
      "enforce": true,
      "allow": [
        "linode-inference/moonshotai/kimi-k2.6-nvfp4",
        "anthropic/claude-haiku-4-5",
        "anthropic/claude-opus-4-8",
        "github-copilot/claude-*",
        "github-copilot/gpt-*"
      ]
    },
    "agentOverrides": {
      "scout": {},
      "researcher": {
        "model": "gpt-6-sol"
      },
      "planner": {
        "model": "gpt-6-terra"
      },
      "worker": {},
      "reviewer": {
        "model": "claude-sonnet-5"
      },
      "context-builder": {},
      "oracle": {
        "model": "claude-opus-5.5"
      },
      "delegate": {}
    }
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "6.0.0",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.81.0",
    "{\"source\":\"npm:pi-autoresearch\",\"scope\":\"user\"}": "1.9.0",
    "{\"source\":\"npm:@tintinweb/pi-tasks\",\"scope\":\"user\"}": "0.9.1"
  }
}